NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
PUBLIC_API_URL=http://localhost:5000/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/sunvika_management
MONGODB_MAX_POOL_SIZE=50
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
BCRYPT_SALT_ROUNDS=12
AWS_REGION=ap-south-2
AWS_S3_BUCKET_NAME=sunvika-media
AWS_S3_PROFILE_BUCKET=
AWS_S3_CUSTOMER_DOCUMENT_BUCKET=
AWS_S3_QUOTATION_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PROFILE_IMAGE_MAX_SIZE_BYTES=5242880
CUSTOMER_DOCUMENT_MAX_SIZE_BYTES=10485760
QUOTATION_COMPANY_ADDRESS=
QUOTATION_COMPANY_PHONE=
QUOTATION_COMPANY_EMAIL=
QUOTATION_AUTHORIZED_SIGNATORY=Authorized Signatory
# Set these only for the protected one-time CLI bootstrap. Never commit real values.
INITIAL_MD_FIRST_NAME=
INITIAL_MD_LAST_NAME=
INITIAL_MD_EMAIL=
INITIAL_MD_MOBILE=
INITIAL_MD_PASSWORD=
INITIAL_MD_EMPLOYEE_CODE=
LOG_LEVEL=debug
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
JSON_BODY_LIMIT=1mb
SWAGGER_ENABLED=true
